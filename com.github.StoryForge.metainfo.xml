<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.github.StoryForge</id>

  <name>StoryForge</name>
  <summary>Story Forge is a modern desktop app for Vintage Story players, designed to make switching between game versions, modpacks, servers, and accounts effortlessly</summary>

  <metadata_license>MIT</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <developer_name id="app.getstoryforge">
    <name>LovelessCodes</name>
  </developer_name>

  <description>
    <p>
      The ultimate launcher for Vintage Story. Experience seamless gameplay with our feature-rich, community-driven launcher designed for the modern adventurer.
    </p>
  </description>

  <launchable type="desktop-id">com.github.StoryForge.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/LovelessCodes/StoryForge/refs/heads/release/screenshots/Overview.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/LovelessCodes/StoryForge/refs/heads/release/screenshots/Mod_Browser.png</image>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/LovelessCodes/StoryForge/refs/heads/release/screenshots/Servers.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <!-- Release version to be inserted just before build time -->
    <release version="FLATPAK_VERSION" date="FLATPAK_DATE">
      <description>
        <p>Story Forge FLATPAK_VERSION</p>
      </description>
    </release>
  </releases>
</component>
