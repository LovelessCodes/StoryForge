{
  "name": "story_forge",
  "version": "2.0.10",
  "private": true,
  "description": "Vintage Story launcher and mod manager",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc-rs && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "screenshots": "bun scripts/screenshots.ts",
    "screenshots:capture": "bun scripts/screenshots/capture.ts",
    "screenshots:platforms": "bun scripts/screenshots/platforms.ts",
    "test": "vitest run",
    "typecheck": "tsc-rs --noEmit",
    "bump": "bun run scripts/bump-version.ts",
    "check:i18n": "bun scripts/check-i18n.ts"
  },
  "dependencies": {
