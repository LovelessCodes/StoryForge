    "input-otp": "^1.5.0",
    "insane": "^2.6.2",
    "lucide-react": "^1.60.0",
    "monaco-editor": "^0.57.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "shadcn": "^4.22.1",
